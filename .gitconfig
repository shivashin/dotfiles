[alias]
    s = status
    b = branch
    c = commit
    a = add
    d = difftool
[diff]
    tool = vimdiff
[difftool]
    prompt = false
# 普段使う名前とアドレスは、dotfiles に入れない ~/.gitconfig.local に書く
[include]
	path = ~/.gitconfig.local
[credential]
	helper = manager
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager
[core]
	editor = vim
[credential "https://dev.azure.com"]
	useHttpPath = true
# dotfiles リポジトリでは個人用のアドレスを使う（~/.gitconfig.local より後に置いて上書きする）
[includeIf "gitdir:~/dotfiles/"]
	path = ~/dotfiles/.gitconfig.dotfiles
