[alias]
    s = status
    b = branch
    c = commit
    a = add
    d = difftool
[diff]
    tool = vimdiff
[difftool]
    prompt = false
[user]
	name = ryo.shibahara
	email = ryo.shibahara@aktsk.jp
[credential]
	helper = manager
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager
[core]
	editor = vim
[credential "https://dev.azure.com"]
	useHttpPath = true
# dotfiles リポジトリでは個人用のアドレスを使う（[user] より後に置いて上書きする）
[includeIf "gitdir:~/dotfiles/"]
	path = ~/dotfiles/.gitconfig.dotfiles
